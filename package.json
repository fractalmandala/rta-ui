{
  "name": "rta-ui",
  "version": "0.1.0",
  "description": "Accessible Svelte 5 UI components with no runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "svelte": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    },
    "./style.css": "./dist/styles/style.css",
    "./reset.css": "./dist/styles/reset.css",
    "./presets/*": "./dist/presets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "prepare": "svelte-kit sync || true",
    "dev": "vite",
    "build": "svelte-package --input src/lib && node scripts/copy-assets.mjs",
    "build:docs": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "parity": "node scripts/check-parity.mjs",
    "docs": "node scripts/gen-docs.mjs",
    "docs:check": "node scripts/gen-docs.mjs --check"
  },
  "peerDependencies": {
    "svelte": "^5.29.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.1",
    "marked": "^18.2.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
